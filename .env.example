# --- Portal de Exames HMV (login feito pelo agente) ---
PORTAL_USER=
PORTAL_PASS=

# --- LLM ---
# gemini = usa GEMINI_API_KEY; bedrock = usa Claude via AWS Bedrock
LLM_PROVIDER=gemini

# Gemini
#GEMINI_API_KEY=
# Chave de outro projeto Google; usada quando a quota da primeira for atingida.
#GEMINI_FALLBACK_API_KEY=
#GEMINI_MODEL=gemini-3.1-flash-lite
#GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# AWS Bedrock / Claude (usado quando LLM_PROVIDER=bedrock)
#BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
#BEDROCK_FALLBACK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
#BEDROCK_MAX_TOKENS=8192
#BEDROCK_RETRY_ATTEMPTS=3
#BEDROCK_AUTH_MODE=default
#AWS_REGION=us-east-1
# Se usar API key do Bedrock, preencha uma destas duas variáveis.
#BEDROCK_API_KEY=
#AWS_BEARER_TOKEN_BEDROCK=
# Se usar IAM/STS, preencha o par abaixo em vez da API key.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=

# --- Google Sheets (fila de pacientes; STATUS = 1) ---
SHEET_URL=https://docs.google.com/spreadsheets/d/SEU_ID/edit
# Conta de serviço com permissão de Editor na planilha:
CREDENTIALS_FILE=credenciais.json

# --- Execução ---
# true = sem janela visível (headless). Em Docker, default já é true.
HEADLESS=false
# Diretório raiz de dados persistentes (downloads/, reports/, historico_downloads.json)
DATA_DIR=data

# --- Armazenamento persistente ---
# local = grava em DATA_DIR; s3 = usa DATA_DIR como temporário e envia os
# artefatos para o bucket privado.
#STORAGE_BACKEND=local
#S3_BUCKET=clickpalmia-exames
#S3_PREFIX=clickpalmia
#S3_REGION=us-east-1
#S3_PRESIGNED_URL_EXPIRY=3600

# Resultados de métricas (telemetria + relatórios; PDFs nunca são enviados).
#RESULTS_S3_URI=s3://clickpalmia-metricas-857145323577/apa

# --- Custo (infra Fargate + LLM) ---
# Tamanho da Task ECS Fargate (mesmo valor para RPA e APA, para comparação justa).
#INFRA_VCPU=1.0
#INFRA_MEMORIA_GB=2.0
# Preços Fargate por hora (US East); ajustar se mudar de região.
#INFRA_CUSTO_VCPU_HORA=0.04048
#INFRA_CUSTO_MEMORIA_GB_HORA=0.004445
# Preço do Gemini 3.1 Flash-Lite, por milhão de tokens (USD).
#LLM_PRECO_MILHAO_ENTRADA=0.25
#LLM_PRECO_MILHAO_SAIDA=1.50
